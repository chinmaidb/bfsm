API_ADDRESS=:9562
APP_ENV=development
DATABASE_URL=postgres://schemeapp:schemeapp@localhost:5432/schemeapp?sslmode=disable
JWT_ISSUER=benefit-scheme-api
JWT_PRIVATE_KEY=./secrets/jwt-private.pem
JWT_LIFETIME_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Provisioned/updated at API startup; keep the password in your secret manager.
SUPER_ADMIN_USERNAME=scheme-super-admin
SUPER_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_16_PLUS_CHARACTER_SECRET
WEB_DIR=./build/bfsm-web

# KYC documents are stored in a private S3 bucket. Use IAM role credentials
# where available; otherwise configure AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
# The bucket CORS policy must allow PUT from the frontend origin and expose ETag.
S3_BUCKET=your-private-kyc-bucket
S3_REGION=ap-south-1
# Optional when not using an IAM role / shared AWS credentials profile.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional for S3-compatible storage (leave blank for AWS S3).
S3_ENDPOINT=
S3_USE_PATH_STYLE=false
